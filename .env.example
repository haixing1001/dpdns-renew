# 多平台免费域名自动续期 - 示例配置
# 至少配置一个平台(DigitalPlat / DNSHE),其余参数已内置默认值,无需设置

# ---------- 单个账号 ----------
DIGITALPLAT_API_KEY=dp_live_xxxxxxxxxxxxxxxxx

# ---------- 多个账号:一行一个 Key(每个账号一行) ----------
# 用引号包住多行值;也兼容英文逗号分隔
# DIGITALPLAT_API_KEY="dp_live_aaaaaaaaaaaaaaaaa
# dp_live_bbbbbbbbbbbbbbbbb"
# DIGITALPLAT_API_KEY=dp_live_aaaaaaaaaaaaaaaaa,dp_live_bbbbbbbbbbbbbbbbb

# ---------- DNSHE(免费域名,续期窗口:到期前 180 天) ----------
# 在 DNSHE 域名页 [API 管理] 创建密钥,得到 API Key(cfsd_ 开头)与 API Secret
# 一行一个账号:API Key 与 API Secret 用 "----" 连接(空格/逗号/冒号也兼容)
# DNSHE_API_KEY="cfsd_xxxxxxxxxxxxxxxxx----yyyyyyyyyyyyyyyyyyyyyyyy"
# 多账号:一行一个
# DNSHE_API_KEY="cfsd_aaaaaaaaaaaaaaaaa----secretAaaaaaaaaaaaaaaaaaaa
# cfsd_bbbbbbbbbbbbbbbbb----secretBbbbbbbbbbbbbbbbbbbb"

# ---------- 以下全部可选(不设置即用内置默认) ----------
# DIGITALPLAT_BASE_URL=https://domain-api.digitalplat.org/api/v1
# DNSHE_BASE_URL=https://api005.dnshe.com/index.php
# DNSHE_RENEW_THRESHOLD_DAYS=180  # DNSHE 提前多少天内续期
# RENEW_THRESHOLD_DAYS=120      # 到期前多少天内续期
# RENEW_YEARS=1                 # 每次续期年数
# RENEW_PAYMENT_METHOD=         # 统一支付方式;留空=按类型自动(free→free,其他→credits)
# RENEW_PAYMENT_FREE=free       # 免费域名支付方式
# RENEW_PAYMENT_PAID=credits    # 其他域名支付方式
# RENEW_DELAY_MS=300            # 每个续期请求间隔
# DRY_RUN=false                 # true=只预览不续期